@{
    ViewBag.Title = "Registration Successful";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-success">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-envelope-check" style="font-size: 4rem; color: #28a745;"></i>
                    </div>
                    <h3>Registration Successful!</h3>
                    <p class="text-muted mt-3">Thank you for registering with Movie Center.</p>
                    <p class="text-muted">We've sent a verification email to your inbox.</p>
                    <div class="alert alert-info mt-4">
                        <strong>Next Steps:</strong>
                        <ol class="text-start mb-0">
                            <li>Check your email inbox</li>
                            <li>Click the verification link</li>
                            <li>Login to your account</li>
                        </ol>
                    </div>
                    <p class="text-muted small mt-3">Didn't receive the email?</p>
                    <a asp-action="ResendVerification" class="btn btn-outline-primary">Resend Verification Email</a>
                </div>
            </div>
        </div>
    </div>
</div>