@{
    ViewBag.Title = "Check Your Email";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-envelope-check" style="font-size: 4rem; color: #28a745;"></i>
                    </div>
                    <h3>Check Your Email</h3>
                    <p class="text-muted">If an account exists with that email, we've sent a password reset link.</p>
                    <p class="text-muted">The link will expire in 1 hour.</p>
                    <a asp-action="Login" class="btn btn-primary mt-3">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
