@{
    ViewBag.Title = "Password Reset Successful";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-success">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-check-circle" style="font-size: 4rem; color: #28a745;"></i>
                    </div>
                    <h3>Password Reset Successful!</h3>
                    <p class="text-muted">Your password has been successfully reset.</p>
                    <p class="text-muted">You can now login with your new password.</p>
                    <a asp-action="Login" class="btn btn-success btn-lg mt-3">Go to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>