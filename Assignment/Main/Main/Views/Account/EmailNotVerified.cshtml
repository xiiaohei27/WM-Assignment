@{
    ViewBag.Title = "Email Not Verified";
    var email = ViewBag.Email as string;
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-warning">
                <div class="card-body p-4 text-center">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle" style="font-size: 4rem; color: #ffc107;"></i>
                    </div>
                    <h3>Email Not Verified</h3>
                    <p class="text-muted mt-3">Please verify your email address before logging in.</p>
                    @if (!string.IsNullOrEmpty(email))
                    {
                        <p class="text-muted">We sent a verification link to: <strong>@email</strong></p>
                    }
                    <div class="alert alert-info mt-4 text-start">
                        <strong>Haven't received the email?</strong>
                        <ul class="mb-0 mt-2">
                            <li>Check your spam/junk folder</li>
                            <li>Make sure you entered the correct email</li>
                            <li>Request a new verification link below</li>
                        </ul>
                    </div>
                    <form method="post" asp-action="ResendVerification" class="mt-4">
                        <input type="hidden" name="email" value="@email" />
                        <button type="submit" class="btn btn-warning">Resend Verification Email</button>
                    </form>
                    <a asp-action="Login" class="btn btn-outline-secondary mt-2">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>