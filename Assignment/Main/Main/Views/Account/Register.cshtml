@model RegisterVM
@inject IConfiguration configuration

@{
    ViewBag.Title = "Account | Register";
    var siteKey = configuration["reCaptchaSettings:SiteKey"];
}

<form class="form" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All"></div>

    <label asp-for="Email"></label>
    <input asp-for="Email" autofocus>
    <span asp-validation-for="Email"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password">
    <span asp-validation-for="Password"></span>

    <label asp-for="Confirm"></label>
    <input asp-for="Confirm">
    <span asp-validation-for="Confirm"></span>

    <label asp-for="Username"></label>
    <input asp-for="Username">
    <span asp-validation-for="Username"></span>

    <label asp-for="Image"></label>
    <label class="upload">
        <small>Select Photo...</small>
        <input asp-for="Image" accept="image/jpeg,image/png" hidden>
        <img src="/images/photo.jpg">
    </label>
    <span asp-validation-for="Image"></span>

    <input type="hidden" id="recaptchaToken" asp-for="RecaptchaToken" />

    @* reCaptcha Checkbox *@
    <div class="card mb-4 shadow-sm text-center">
        <div class="recaptcha-box">
            <div id="html_element"></div>
        </div>
    </div>

    <section>
        <button type="submit">Register</button>
        <button type="reset">Reset</button>
    </section>
</form>

@section foot {
    <script>
        $.validator.setDefaults({ ignore: '' });
    </script>
}

<script>
    var onloadCallback = function () {
        grecaptcha.render('html_element', {
            sitekey: '@siteKey',
            callback: function (token) {
                document.getElementById("recaptchaToken").value = token;
            }
        });
    };
</script>

<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit"
        async defer>
</script>