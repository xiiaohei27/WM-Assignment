@{
    ViewBag.Title = "Email Verified";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-success">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <i class="bi bi-patch-check" style="font-size: 4rem; color: #28a745;"></i>
                    </div>
                    <h3>Email Verified Successfully!</h3>
                    <p class="text-muted mt-3">Your email has been verified.</p>
                    <p class="text-muted">You can now access all features of Movie Center.</p>
                    <a asp-action="Login" class="btn btn-success btn-lg mt-3">Login Now</a>
                </div>
            </div>
        </div>
    </div>
</div>