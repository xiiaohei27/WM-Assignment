@model IEnumerable<Seat>
@{
    var showtime = ViewBag.Showtime as Showtime;
    var bookedSeats = ViewBag.BookedSeats as List<string>;
    ViewBag.Title = "Select Seats for " + showtime.Movie.Title;

    var seatRows = Model
    // Sort by row letter (A, B, C...)
    .OrderBy(s => s.SeatNumber[0])
    // Sort by seat number (001, 002, 010 → 1, 2, 10)
    .ThenBy(s => int.Parse(s.SeatNumber.Substring(1)))
    // Group seats by row letter
    .GroupBy(s => s.SeatNumber[0].ToString())
    .ToList();
}

<p>@showtime.Hall.Cinema.Name - @showtime.Hall.Name</p>
<p>@showtime.StartDateTime.ToString("dddd, MMM dd yyyy hh:mm tt")</p>

<form method="post" asp-controller="Seat" asp-action="SelectSeats">
    <input type="hidden" name="showtimeId" value="@showtime.Id" />

    <div style="display:flex; flex-direction:column; gap:5px;">
        @foreach (var row in seatRows)
        {
            <div style="display:flex; gap:5px;">
                @foreach (var seat in row)
                {
                    var isBooked = bookedSeats.Contains(seat.Id);
                    <div>
                        <input type="checkbox" name="selectedSeatIds" value="@seat.Id" @(isBooked ? "disabled" : "") />
                        <label>@seat.SeatNumber</label>
                    </div>
                }
            </div>
        }
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Showtime" asp-action="SelectShowtime" asp-route-movieId="@showtime.Movie.Id"
           asp-route-date="@showtime.StartDateTime.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">← Back</a>
        <button type="submit" class="btn btn-primary">Next →</button>
    </div>
</form>