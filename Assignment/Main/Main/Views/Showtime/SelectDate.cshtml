@model IEnumerable<DateTime>
@{
    var movie = ViewBag.Movie as Movie;
    ViewBag.Title = "2. Select Date";
}

<div class="container my-4">
    <h3 class="mb-3 text-center">Select Date for <strong>@movie.Title</strong></h3>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        @foreach (var date in Model)
        {
            <a asp-controller="Showtime" asp-action="SelectShowtime"
               asp-route-movieId="@movie.Id"
               asp-route-date="@date.ToString("yyyy-MM-dd")"
               class="btn btn-outline-primary btn-lg">
                @date.ToString("dddd, MMM dd yyyy")
            </a>
        }
    </div>

    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Cinema" asp-action="SelectCinema" asp-route-movieId="@movie.Id" class="btn btn-outline-secondary">← Back</a>
    </div>
</div>