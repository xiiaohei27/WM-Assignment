@model IEnumerable<Showtime>
@{
    var movie = (Movie)ViewBag.Movie;
    var date = (DateTime)ViewBag.Date;
    ViewBag.Title = "3. Select Showtime";
}


<div class="container my-4">
    <h3 class="mb-3 text-center">
        Select Showtime for <strong>@movie.Title</strong> on <strong>@date.ToString("dddd, MMM dd yyyy")</strong>
    </h3>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        @foreach (var show in Model)
        {
            <a asp-controller="Seat" asp-action="SelectSeats"
               asp-route-showtimeId="@show.Id"
               class="btn btn-outline-primary btn-lg">
                @show.StartDateTime.ToString("hh:mm tt") - Hall: @show.Hall.Name
            </a>
        }
    </div>


    <div class="d-flex justify-content-between mt-4">
        <a asp-controller="Showtime" asp-action="SelectDate" asp-route-movieId="@movie.Id" class="btn btn-outline-secondary">← Back</a>
    </div>
</div>