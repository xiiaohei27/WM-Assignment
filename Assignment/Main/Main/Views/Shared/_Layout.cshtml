@inject DB DB
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/images/logo.png" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" />
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    @RenderSection("head", false)
</head>
<body>
    <header class="site-header bg-light border-bottom">
        <div class="container d-flex align-items-center py-2">
            <h1 class="h5 mb-0 me-3"><a class="text-dark text-decoration-none" href="/">Silver Screen Cinema</a></h1>

            <div class="ms-auto d-flex align-items-center gap-3 small text-muted d-none d-md-flex">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="d-flex align-items-center gap-2">
                        @{
                            // Identity.Name contains the email (you sign in with email). Lookup the user record to get the Username.
                            var identityName = User.Identity?.Name;
                            string? photoURL = null;
                            string displayName;
                            if (!string.IsNullOrEmpty(identityName) && DB != null)
                            {
                                var dbUser = DB.Users.FirstOrDefault(u => u.Email == identityName);
                                photoURL = dbUser?.Image;
                                displayName = dbUser?.Username ?? identityName;
                            }
                            else
                            {
                                displayName = identityName ?? "";
                            }
                        }
                        @if (!string.IsNullOrEmpty(photoURL))
                        {
                            <img src="/photos/@photoURL" alt="avatar" class="rounded-circle" style="width:32px;height:32px;object-fit:cover;border:1px solid #ddd;" />
                        }
                        <span>@displayName</span>
                        <span class="text-secondary">|</span>
                        <span>@(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Member") ? "Member" : "User")</span>
                    </div>
                }
            </div>
        </div>
    </header>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <div class="navbar-collapse collapse show">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                    @if (!User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/"><i class="bi bi-house"></i> Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Movie" asp-action="Index"><i class="bi bi-film"></i> Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Food" asp-action="Index"><i class="bi bi-cup-straw"></i> Food &amp; Beverage</a>
                        </li>
                        <li class="nav-item position-relative">
                            @{
                                var cart = Context.Session.GetObject<List<Main.CartItem>>("FoodCart");
                                var cartCount = cart?.Sum(c => c.Quantity) ?? 0;
                            }
                            <a class="nav-link" asp-controller="Food" asp-action="Cart">
                                <i class="bi bi-cart"></i> Cart
                                @if (cartCount > 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">@cartCount</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Ticket" asp-action="History"><i class="bi bi-clock-history"></i> History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Food" asp-action="MyOrders"><i class="bi bi-clock-history"></i> Order History</a>
                        </li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Admin</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Report"><i class="bi bi-bar-chart"></i> Report</a>
                        </li>
                    }

                    @if (User.IsInRole("Member"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="UpdateProfile"><i class="bi bi-person-circle"></i> Profile</a>
                        </li>
                    }
                </ul>

                @* Right-side auth links: placed at the end of navbar container *@
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/UpdatePassword"><i class="bi bi-key"></i> Change Password</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Account/Logout"><i class="bi bi-box-arrow-right"></i> Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="/Account/Login"><i class="bi bi-box-arrow-in-right"></i> Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Account/Register"><i class="bi bi-person-plus"></i> Register</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Account/ForgotPassword"><i class="bi bi-question-circle"></i> Forgot Password</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <h1 class="h3 mb-4">@ViewBag.Title</h1>

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info fade-alert">
                @Html.Raw(TempData["Info"])
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning fade-alert">
                @Html.Raw(TempData["Warning"])
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger fade-alert">
                @Html.Raw(TempData["Error"])
            </div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success fade-alert">
                @Html.Raw(TempData["Success"])
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-light border-top py-3 mt-auto">
        <div class="container text-center small">
            Developed by <strong>Team RSD</strong> &middot; Copyright &copy; @DateTime.Today.Year
        </div>
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                const alerts = document.querySelectorAll('.fade-alert');
                if (!alerts.length) return;

                alerts.forEach(alert => {
                    alert.style.transition = 'opacity 0.5s ease, max-height 0.5s ease';
                    alert.classList.add('show');

                    setTimeout(() => {
                        alert.style.opacity = '0';
                        alert.style.maxHeight = '0px';
                        setTimeout(() => {
                            if (alert.parentNode) alert.parentNode.removeChild(alert);
                        }, 500);
                    }, 3000);
                });
            } catch (e) {
                console.error('Alert timeout error:', e);
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

    @RenderSection("foot", false)
    @RenderSection("Scripts", required: false)
</body>
</html>