@inject DB DB
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    @RenderSection("head", false)
</head>
<body>
    <header>
        <h1><a href="/">Movie Center</a></h1>

        @* User email and role *@
        @if (User.Identity!.IsAuthenticated)
        {
            <div>
                @User.Identity.Name |
                @(User.IsInRole("Admin") ? "Admin" : "")
                @(User.IsInRole("Member") ? "Member" : "")
            </div>
        }

        @* Member photo *@
        @if (User.IsInRole("Member"))
        {
            var username = User.Identity?.Name;
            string? photoURL = null;
            if (!string.IsNullOrEmpty(username) && DB != null)
            {
                var user = DB.Users.Find(username);
                photoURL = user?.Image;
            }

            if (!string.IsNullOrEmpty(photoURL))
            {
                <img src="/photos/@photoURL" alt="Member photo">
            }
        }

        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">
                @Html.Raw(TempData["Info"])
            </div>
        }

        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning">
                @Html.Raw(TempData["Warning"])
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @Html.Raw(TempData["Error"])
            </div>
        }

    </header>

    <nav>
        <a href="/">Index</a>
        <a asp-controller="Movie" asp-action="Index">Movies</a>
        <a asp-controller="Food" asp-action="Index">Food & Beverage</a>

        @* Cart Icon with Badge *@
        @{
            var cart = Context.Session.GetObject<List<Main.CartItem>>("FoodCart");
            var cartCount = cart?.Sum(c => c.Quantity) ?? 0;
        }
        <a asp-controller="Food" asp-action="Cart" class="position-relative">
            Cart
            @if (cartCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @cartCount
                </span>
            }
        </a>

        @* Menu trimming *@
        @if (User.IsInRole("Member"))
        {
            <a href="/Home/Member">Member</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a href="/Home/Admin">Admin</a>
        }

        <div></div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Account/Logout">Logout</a>
            <a href="/Account/UpdatePassword">Renew Password</a>
        }
        else
        {
            <a href="/Account/Login">Login</a>
            <a href="/Account/Register">Register</a>
            <a href="/Account/ResetPassword">Reset Password</a>
        }

    </nav>

    <!-- Replace the existing nav section in your _Layout.cshtml with this -->
    <nav>
        <a href="/">Index</a>
        <a asp-controller="Movie" asp-action="Index">Movies</a>
        <a asp-controller="Food" asp-action="Index">Food & Beverage</a>

        @* Cart Icon with Badge *@
        @{
            var cart = Context.Session.GetObject<List<Main.CartItem>>("FoodCart");
            var cartCount = cart?.Sum(c => c.Quantity) ?? 0;
        }
        <a asp-controller="Food" asp-action="Cart" class="position-relative">
            Cart
            @if (cartCount > 0)
            {
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    @cartCount
                </span>
            }
        </a>

        @* Admin Menu *@
        @if (User.IsInRole("Admin"))
        {
            <div class="dropdown d-inline-block">
                <a class="dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Admin
                </a>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Member Management</h6></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Members">Manage Members</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Food & Beverage</h6></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="FoodCategories">Manage Categories</a></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="FoodItems">Manage Food Items</a></li>
                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="CreateFoodItem">Add Food Item</a></li>
                </ul>
            </div>
        }

        <div></div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Account/Logout">Logout</a>
            <a href="/Account/UpdatePassword">Renew Password</a>

            @if (User.IsInRole("Member"))
            {
                <a href="/Account/UpdateProfile">Update Profile</a>
            }
        }
        else
        {
            <a href="/Account/Login">Login</a>
            <a href="/Account/Register">Register</a>
            <a href="/Account/ForgotPassword">Forgot Password</a>
        }
    </nav>

    <main>
        <h1>@ViewBag.Title</h1>
        @RenderBody()
    </main>

    <style>
        /* make sure we have a transition available */
        .fade-alert {
            transition: opacity 0.5s ease, max-height 0.5s ease;
            opacity: 1;
            max-height: 200px; /* adjust if needed */
            overflow: hidden;
        }
    </style>

    <footer>
        Developed by <b>Team RSD</b> &middot;
        Copyrighted &copy; @DateTime.Today.Year
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
          try {
            // pick up alerts rendered by TempData (any alert class)
            const alerts = document.querySelectorAll('.fade-alert, .alert');
            if (!alerts.length) return;

            alerts.forEach(alert => {
              // ensure transition exists
              alert.style.transition = alert.style.transition || 'opacity 0.5s ease, max-height 0.5s ease';
              // show (in case bootstrap uses .fade/.show behaviour)
              alert.classList.add('show');

              // wait 2.5s then fade and remove
              setTimeout(() => {
                alert.style.opacity = '0';
                alert.style.maxHeight = '0px';
                // remove from DOM after transition
                setTimeout(() => {
                  if (alert.parentNode) alert.parentNode.removeChild(alert);
                }, 500); // must match CSS transition duration
              }, 2500);
            });
          } catch (e) {
            console.error('Alert timeout error:', e);
          }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>
    @RenderSection("foot", false)
</body>
</html>