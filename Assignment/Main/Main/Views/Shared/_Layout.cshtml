@inject DB DB
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <link rel="shortcut icon" href="/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap">
    <link rel="stylesheet" href="/css/app.css" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    @RenderSection("head", false)
</head>
<body>
    <header>
        <h1><a href="/">Movie Center</a></h1>

        @* User email and role *@
        @if (User.Identity!.IsAuthenticated)
        {
            <div>
                @User.Identity.Name |
                @(User.IsInRole("Admin") ? "Admin" : "")
                @(User.IsInRole("Member") ? "Member" : "")
            </div>
        }

        @* Member photo *@
        @if (User.IsInRole("Member"))
        {
            var username = User.Identity?.Name;
            string? photoURL = null;
            if (!string.IsNullOrEmpty(username) && DB != null)
            {
                var user = DB.Users.FirstOrDefault(u => u.Email == username);
                photoURL = user?.Image;
            }

            if (!string.IsNullOrEmpty(photoURL))
            {
                <img src="/photos/@photoURL" alt="Member photo">
            }
        }
    </header>

    <nav>
        <a href="/">Index</a>
        <a asp-controller="Movie" asp-action="Index">Movies</a>

        @* Menu trimming *@
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Home/Both">Both</a>
        }
        @if (User.IsInRole("Member"))
        {
            <a href="/Home/Member">Member</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a href="/Home/Admin">Admin</a>
        }

        <div></div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a href="/Account/Logout">Logout</a>
            <a href="/Account/UpdatePassword">Update Password</a>
        }
        else
        {
            <a href="/Account/Login">Login</a>
            <a href="/Account/Register">Register</a>
            <a href="/Account/ResetPassword">Reset Password</a>
        }
        @if (User.IsInRole("Member"))
        {
            <a href="/Account/UpdateProfile">Update Profile</a>
        }
    </nav>

    <main>
        <h1>@ViewBag.Title</h1>
        @RenderBody()
    </main>

    <footer>
        Developed by <b>Team RSD</b> &middot;
        Copyrighted &copy; @DateTime.Today.Year
    </footer>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/jquery.unobtrusive-ajax.min.js"></script>
    <script src="/js/jquery.validate.min.js"></script>
    <script src="/js/jquery.validate.unobtrusive.min.js"></script>
    <script src="/js/app.js" asp-append-version="true"></script>
    @RenderSection("foot", false)
</body>
</html>
