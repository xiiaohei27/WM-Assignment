@model List<FoodItem>
@{
    ViewBag.Title = "Food & Beverage";
    var categories = ViewBag.Categories as List<FoodCategory>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as string;
}

<div class="container mt-4">
    <h2>Food & Beverage Menu</h2>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select id="categorySelector" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" @(selectedCategoryId == cat.Id ? "selected" : "")>@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Search by name...">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="button" id="clearBtn" class="btn btn-outline-secondary w-100">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Food Items Grid -->
    <div id="foodItemsContainer" class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">No food items available in this category.</div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="~/food/@item.Image" class="card-img-top" alt="@item.Name"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-white fs-4">@item.Name</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h4 mb-0 text-primary">RM @item.Price.ToString("F2")</span>
                                <span class="badge bg-info">@item.Category.Name</span>
                            </div>

                            <!-- Add to Cart Form -->
                            <form method="post" asp-action="AddToCart" class="d-flex gap-2">
                                <input type="hidden" name="foodItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="1" min="1" max="10"
                                       class="form-control" style="width: 80px;">
                                <button type="submit" class="btn btn-success flex-grow-1">
                                    Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <p id="itemCount" class="mt-3 text-muted">Total: @Model.Count item(s)</p>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        function loadFoodItems() {
            var categoryId = $('#categorySelector').val();
            var search = $('#searchInput').val();

            $.get('/Food/GetFoodItemsByFilter', {
                categoryId: categoryId,
                search: search
            }, function(data) {
                var container = $('#foodItemsContainer');
                container.empty();

                if (!data || data.length === 0) {
                    container.append('<div class="col-12"><div class="alert alert-info">No food items available.</div></div>');
                    $('#itemCount').text('Total: 0 item(s)');
                    return;
                }

                data.forEach(function(item) {
                    var imageHtml = item.image
                        ? '<img src="/food/' + item.image + '" class="card-img-top" alt="' + item.name + '" style="height:200px;object-fit:cover;">'
                        : '<div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;"><span class="text-white fs-4">' + item.name + '</span></div>';

                    var description = item.description || '';
                    var shortDesc = description.length > 60 ? description.substring(0, 60) + '...' : description;

                    var card = '<div class="col-md-4 col-sm-6 mb-4">' +
                        '<div class="card h-100 shadow-sm">' +
                            imageHtml +
                            '<div class="card-body d-flex flex-column">' +
                                '<h5 class="card-title">' + item.name + '</h5>' +
                                '<p class="card-text text-muted small flex-grow-1">' + shortDesc + '</p>' +
                                '<div class="d-flex justify-content-between align-items-center mb-3">' +
                                    '<span class="h4 mb-0 text-primary">RM ' + item.price.toFixed(2) + '</span>' +
                                    '<span class="badge bg-info">' + item.categoryName + '</span>' +
                                '</div>' +
                                '<form method="post" action="/Food/AddToCart" class="d-flex gap-2">' +
                                    '<input type="hidden" name="foodItemId" value="' + item.id + '" />' +
                                    '<input type="number" name="quantity" value="1" min="1" max="10" class="form-control" style="width:80px;">' +
                                    '<button type="submit" class="btn btn-success flex-grow-1">Add to Cart</button>' +
                                '</form>' +
                            '</div>' +
                        '</div>' +
                    '</div>';

                    container.append(card);
                });

                $('#itemCount').text('Total: ' + data.length + ' item(s)');
            });
        }

        // Real-time filtering
        $('#categorySelector').on('change', loadFoodItems);
        $('#searchInput').on('input', loadFoodItems);

        // Clear button
        $('#clearBtn').click(function() {
            $('#categorySelector').val('');
            $('#searchInput').val('');
            loadFoodItems();
        });
    });
</script>