@model List<FoodItem>
@{
    ViewBag.Title = "Manage Food Items";
    var categories = ViewBag.Categories as List<FoodCategory>;
    var selectedCategoryId = ViewBag.CategoryId as string;
    var searchTerm = ViewBag.Search as string;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Food Items</h2>
        <div>
            <a asp-action="CreateFoodItem" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Food Item
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select id="categorySelector" class="form-select">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            <option value="@cat.Id" selected="@(selectedCategoryId == cat.Id)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" id="searchInput" class="form-control"
                           placeholder="Search by name..." value="@searchTerm">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="button" id="clearBtn" class="btn btn-outline-secondary w-100">Clear</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Food Items Grid -->
    <div id="foodItemsContainer" class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">No food items available in this category.</div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="~/food/@item.Image" class="card-img-top" alt="@item.Name"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-white fs-4">No Image</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(item.Description?.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                            </p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h5 mb-0 text-primary">RM @item.Price.ToString("F2")</span>
                                <span class="badge bg-info">@item.Category.Name</span>
                            </div>
                            <div class="mb-2">
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Unavailable</span>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                <a asp-action="EditFoodItem" asp-route-id="@item.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-action="DeleteFoodItem" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <p id="itemCount" class="mt-3 text-muted">Total: @Model.Count item(s)</p>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function() {
        function loadFoodItems() {
            var categoryId = $('#categorySelector').val();
            var search = $('#searchInput').val();

            $.get('/Admin/GetFoodItemsByFilter', {
                categoryId: categoryId,
                search: search
            }, function(data) {
                var container = $('#foodItemsContainer');
                container.empty();

                if (!data || data.length === 0) {
                    container.append('<div class="col-12"><div class="alert alert-info">No food items available.</div></div>');
                    $('#itemCount').text('Total: 0 item(s)');
                    return;
                }

                data.forEach(function(item) {
                    var imageHtml = item.image
                        ? '<img src="/food/' + item.image + '" class="card-img-top" alt="' + item.name + '" style="height:200px;object-fit:cover;">'
                        : '<div class="card-img-top bg-secondary d-flex align-items-center justify-content-center" style="height:200px;"><span class="text-white fs-4">No Image</span></div>';

                    var description = item.description || 'No description';
                    var shortDesc = description.length > 100 ? description.substring(0, 100) + '...' : description;

                    var availabilityBadge = item.isAvailable
                        ? '<span class="badge bg-success"><i class="bi bi-check-circle"></i> Available</span>'
                        : '<span class="badge bg-danger"><i class="bi bi-x-circle"></i> Unavailable</span>';

                    var card = '<div class="col-md-4 col-sm-6 mb-4">' +
                        '<div class="card h-100 shadow-sm">' +
                            imageHtml +
                            '<div class="card-body d-flex flex-column">' +
                                '<h5 class="card-title">' + item.name + '</h5>' +
                                '<p class="card-text text-muted small flex-grow-1">' + shortDesc + '</p>' +
                                '<div class="d-flex justify-content-between align-items-center mb-3">' +
                                    '<span class="h5 mb-0 text-primary">RM ' + item.price.toFixed(2) + '</span>' +
                                    '<span class="badge bg-info">' + item.categoryName + '</span>' +
                                '</div>' +
                                '<div class="mb-2">' + availabilityBadge + '</div>' +
                                '<div class="d-grid gap-2">' +
                                    '<a href="/Admin/EditFoodItem/' + item.id + '" class="btn btn-sm btn-primary">' +
                                        '<i class="bi bi-pencil"></i> Edit' +
                                    '</a>' +
                                    '<a href="/Admin/DeleteFoodItem/' + item.id + '" class="btn btn-sm btn-danger">' +
                                        '<i class="bi bi-trash"></i> Delete' +
                                    '</a>' +
                                '</div>' +
                            '</div>' +
                        '</div>' +
                    '</div>';

                    container.append(card);
                });

                $('#itemCount').text('Total: ' + data.length + ' item(s)');
            }).fail(function() {
                var container = $('#foodItemsContainer');
                container.html('<div class="col-12"><div class="alert alert-danger">Error loading food items. Please refresh the page.</div></div>');
            });
        }

        // Real-time filtering
        $('#categorySelector').on('change', loadFoodItems);
        $('#searchInput').on('input', loadFoodItems);

        // Clear button
        $('#clearBtn').click(function() {
            $('#categorySelector').val('');
            $('#searchInput').val('');
            loadFoodItems();
        });
    });
</script>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        }
</style>