@model FoodItem
@{
    ViewBag.Title = "Delete Food Item";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Delete Food Item</h2>
        <a asp-action="FoodItems" class="btn btn-secondary">Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-danger">
                        <strong>Warning:</strong> This action cannot be undone!
                    </div>

                    <div class="text-center mb-3">
                        @if (!string.IsNullOrEmpty(Model.Image))
                        {
                            <img src="/food/@Model.Image" alt="@Model.Name"
                                 class="rounded" style="max-width: 200px;">
                        }
                        else
                        {
                            <div class="bg-secondary rounded mx-auto" style="width: 200px; height: 200px;"></div>
                        }
                    </div>

                    <h5 class="text-center">@Model.Name</h5>
                    <p class="text-center text-muted">@Model.Description</p>

                    <hr>

                    <div class="row text-center mb-3">
                        <div class="col-6">
                            <strong>Price:</strong><br>
                            RM @Model.Price.ToString("F2")
                        </div>
                        <div class="col-6">
                            <strong>Category:</strong><br>
                            @Model.Category.Name
                        </div>
                    </div>

                    <p>Are you sure you want to delete this food item?</p>
                    <ul>
                        <li>The item will be removed from the menu</li>
                        <li>The item's image will be deleted</li>
                        <li>Order history will be retained</li>
                    </ul>

                    <form method="post" class="mt-4">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> Yes, Delete This Item
                            </button>
                            <a asp-action="FoodItems" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>