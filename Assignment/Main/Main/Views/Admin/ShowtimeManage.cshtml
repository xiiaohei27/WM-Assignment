@model List<Showtime>
@{
	ViewBag.Title = "Manage Showtime";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Movie Showtime</h2>
        <div>
            <a asp-action="CreateShowtime" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Movie Showtime
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Movie</label>
                    <select name="movieId" class="form-select" onchange="this.form.submit()">
                        <option value="">All Movies</option>
                        @foreach (var movie in ViewBag.Movies)
                        {
                            <option value="@movie.Id" selected="@(ViewBag.SelectedMovieId == movie.Id)">
                                @movie.Title
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by name..." value="@ViewBag.Search">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.SelectedGenre))
                        {
                            <a asp-action="ShowtimeManage" class="btn btn-outline-secondary">Clear</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>HallId</th>
                            <th>StartDateTime</th>
                            <th>EndDateTime</th>
                            <th>TicketPrice</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">No Movie found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var showtime in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(showtime.Movie.Image))
                                        {
                                            <img src="~/images/@showtime.Movie.Image" alt="@showtime.Movie.Title"
                                                 class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px;">
                                                <span class="text-white">N/A</span>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@showtime.Movie.Title</strong>
                                        @if (!string.IsNullOrEmpty(showtime.Movie.Description))
                                        {
                                            <br>

                                            <small class="text-muted">@(showtime.Movie.Description.Length > 50 ? showtime.Movie.Description.Substring(0, 50) + "..." : showtime.Movie.Description)</small>
                                        }
                                    </td>
                                    <td>@showtime.HallId</td>
                                    <td><strong>@showtime.StartDateTime.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></td>
                                    <td><strong>@showtime.EndDateTime.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></td>
                                    <td>@($"RM {showtime.TicketPrice:F2}")</td>
                                    <td>
                                        <a asp-action="EditShowtime" asp-route-id="@showtime.Movie.Id"
                                           class="btn btn-sm btn-primary">Edit</a>
                                        <a asp-action="DeleteShowtime" asp-route-id="@showtime.Movie.Id"
                                           class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>