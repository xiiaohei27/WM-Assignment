@model List<Showtime>
@{
	ViewBag.Title = "Manage Showtime";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="CreateShowtime" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Movie Showtime
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Movie</label>
                    <select id="movieSelector" name="movieId" class="form-select">
                        <option value="">All Movies</option>
                        @foreach (var movie in ViewBag.Movies)
                        {
                            <option value="@movie.Id" selected="@(ViewBag.SelectedMovieId == movie.Id)">
                                @movie.Title
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" id="searchInput" name="search" class="form-control"
                           placeholder="Search by name..." value="@ViewBag.Search">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid gap-2">
                        <button type="button" id="filterBtn" class="btn btn-primary">Filter</button>
                        <button type="button" id="clearBtn" class="btn btn-outline-secondary">Clear</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>HallId</th>
                            <th>StartDateTime</th>
                            <th>EndDateTime</th>
                            <th>TicketPrice</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">No Movie found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var showtime in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(showtime.Movie.Image))
                                        {
                                            <img src="~/images/@showtime.Movie.Image" alt="@showtime.Movie.Title"
                                                 class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px;">
                                                <span class="text-white">N/A</span>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@showtime.Movie.Title</strong>
                                        @if (!string.IsNullOrEmpty(showtime.Movie.Description))
                                        {
                                            <br>

                                            <small class="text-muted">@(showtime.Movie.Description.Length > 50 ? showtime.Movie.Description.Substring(0, 50) + "..." : showtime.Movie.Description)</small>
                                        }
                                    </td>
                                    <td>@showtime.HallId</td>
                                    <td><strong>@showtime.StartDateTime.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></td>
                                    <td><strong>@showtime.EndDateTime.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></td>
                                    <td>@($"RM {showtime.TicketPrice:F2}")</td>
                                    <td>
                                        <a asp-action="EditShowtime" asp-route-id="@showtime.Id"
                                           class="btn btn-sm btn-primary">Edit</a>
                                        <a asp-action="DeleteShowtime" asp-route-id="@showtime.Id"
                                           class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {

        function loadShowtimes() {
            var movieId = $('#movieSelector').val();
            var search = $('#searchInput').val();

            $.get('/Admin/GetShowtimeByFilter', {
                movieId: movieId,
                search: search
            }, function (data) {

                var tbody = $('table tbody');
                tbody.empty();

                if (!data || data.length === 0) {
                    tbody.append('<tr><td colspan="7" class="text-center">No Showtime found.</td></tr>');
                    return;
                }

                data.forEach(function (s) {

                    var imageHtml = s.image
                        ? '<img src="/images/' + s.image + '" class="rounded" style="width:50px;height:50px;object-fit:cover;">'
                        : '<div class="bg-secondary rounded d-flex align-items-center justify-content-center"style="width:50px;height:50px;"><span class="text-white">N/A</span> </div>';

					tbody.append('<tr>' +
                            '<td>' + imageHtml + '</td>' +
                            '<td><strong>'+ s.movieTitle +'</strong></td>'+
                            '<td>'+ s.hallId +'</td>' +
                            '<td><strong>'+ new Date(s.startDateTime).toLocaleString() +'</strong></td>' +
                            '<td><strong>'+ new Date(s.endDateTime).toLocaleString() +'</strong></td>' +
                            '<td>RM ' + parseFloat(s.ticketPrice).toFixed(2) +'</td>' +
							'<td>' +
                                '<a href="/Admin/EditShowtime/'+ s.id +'" class="btn btn-sm btn-primary">Edit</a>' +
                                '<a href="/Admin/DeleteShowtime/'+ s.id +'" class="btn btn-sm btn-danger">Delete</a>' +
                            '</td>'+
                        '</tr>');
                });
            });
        }

        // 🔴 Real-time events
        $('#movieSelector').on('change', loadShowtimes);
        $('#searchInput').on('input', loadShowtimes);


        $('#filterBtn').click(loadShowtimes);
        $('#clearBtn').click(function() {
            $('#movieSelector').val('');
            $('#searchInput').val('');
            loadShowtimes();
        });
    });
</script>