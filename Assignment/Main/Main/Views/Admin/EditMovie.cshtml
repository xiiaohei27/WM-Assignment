@model MovieEditVM
@{
    ViewBag.Title = "Edit Movie";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Edit Movie</h2>
        <a asp-action="MovieManage" class="btn btn-secondary">Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label"></label>
                            <input asp-for="Title" class="form-control" placeholder="Movie Title" autofocus>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Genre" class="form-label"></label>
                                <select asp-for="Genre" class="form-select" id="genreSelect">
                                    @foreach (var gen in ViewBag.Genre)
                                    {
                                        <option value="@gen">
                                            @gen
                                        </option>
                                    }
                                    <option value="new">Other Genre</option>
                                </select>
                                @* d-none is hidden use bootstrap*@
                                <input type="text"
                                       class="form-control mt-2 d-none"
                                       id="newGenreInput"
                                       name="NewGenre"
                                       placeholder="Enter new genre" />
                                <span asp-validation-for="Genre" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="ReleaseDate" class="form-label"></label>
                                <input asp-for="ReleaseDate" type="datetime-local" class="form-control" value="@Model.ReleaseDate.ToString("yyyy-MM-ddTHH:mm")">
                                <span asp-validation-for="ReleaseDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Classification" class="form-label"></label>
                                <input asp-for="Classification" class="form-control" placeholder="Movie Classification">
                                <span asp-validation-for="Classification" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="SpokenLanguage" class="form-label"></label>
                                <input asp-for="SpokenLanguage" class="form-control" placeholder="Movie SpokenLanguage">
                                <span asp-validation-for="SpokenLanguage" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="RunningTime" class="form-label"></label>
                                <input asp-for="RunningTime" class="form-control" placeholder="Movie Running Time (minutes)">
                                <span asp-validation-for="RunningTime" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Director" class="form-label"></label>
                                <input asp-for="Director" class="form-control" placeholder="Movie Director">
                                <span asp-validation-for="Director" class="text-danger"></span>
                            </div>
                        </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Cast" class="form-label"></label>
                                <input asp-for="Cast" class="form-control" placeholder="Movie Casts">
                                <span asp-validation-for="Cast" class="text-danger"></span>
                            </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Trailer" class="form-label">Trailer Upload</label>
                                    @if (!string.IsNullOrEmpty(Model.TrailerURL))
                                    {
                                        <div class="mb-2">
                                             <video class="rounded" style="max-width: 400px; height: auto;" controls>
                                                <source src="/trailers/@Model.TrailerURL" type="video/mp4">
                                                Your browser does not support the video tag.
                                            </video>
                                            <p class="text-muted small">Current Trailer</p>
                                        </div>
                                    }
                                <input asp-for="Trailer" type="file" class="form-control" accept="video/mp4">
                                <span asp-validation-for="Trailer" class="text-danger"></span>
                                <small class="text-muted">MP4 only, max 100MB</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Image" class="form-label">Movie Thumbnail</label>

                                    @if (!string.IsNullOrEmpty(Model.ImageURL))
                                    {
                                        <div class="mb-2">
                                            <img src="/images/@Model.ImageURL" alt="Current image"
                                                    class="rounded" style="max-width: 200px;">
                                            <p class="text-muted small">Current Thumbnail</p>
                                        </div>
                                    }
                                <input asp-for="Image" type="file" class="form-control" accept="image/jpeg,image/png">
                                        <span asp-validation-for="Image" class="text-danger"></span>
                                        <small class="text-muted">JPG or PNG, max 5MB</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Description of the Movie"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Update Movie
                            </button>
                            <a asp-action="MovieManage" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section foot {
    <script>
        const genreSelect = document.getElementById("genreSelect"); //find select with id:genreSelect
        const newGenreInput = document.getElementById("newGenreInput"); //find input with id:newGenreInput

        genreSelect.addEventListener("change", function () { //when user change the selection run this
            if (this.value === "new") {
                newGenreInput.classList.remove("d-none"); //if it is new then remove hidden and show textbox
                newGenreInput.required = true; //Input Required (must type in)
            } else {
                newGenreInput.classList.add("d-none");
                newGenreInput.value = "";
                newGenreInput.required = false;
            }
        });
    </script>
}
