@{
    ViewBag.Title = "Report";
}

<select id="reportSelector">
    <option value="TicketsSoldReport">Tickets Sold per Movie</option>
    <option value="RevenueReport">Revenue Earned per Movie</option>
    <option value="TicketsOverTimeReport">Tickets Sold Over Time</option>
    <option value="RevenueOverTimeReport">Revenue Earned Over Time</option>
    <option value="SeatTypeUsageReport">Seat Type Usage</option>
    <option value="ShowtimePerformanceReport">Showtime Performance</option>
</select>

<div style="width: 50%; max-width: 600px; margin: auto;">
    <canvas id="chart"></canvas>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        var chart;

        // Function to load report data and render chart
        function loadReport(action) {
            // AJAX request to the server
            $.ajax({
                url: '/Admin/' + action,  // 1. URL endpoint for report
                type: 'GET',              // 2. HTTP GET method
                dataType: 'json',         // 3. Expect JSON response from server
                success: function(data) { // 4. Called when server responds successfully
                    console.log(data);    // Debug: logs the received data to the console

                    // Initialize variables safely
                    var labels = [];
                    var dataset = [];
                    var type = 'bar';
                    var label = '';

                    // Determine chart type and data based on selected report
                    switch(action) {

                        case 'TicketsSoldReport':
                            labels = data.map(d => d.movie);        // Movie titles
                            dataset = data.map(d => d.ticketsSold); // Tickets sold per movie
                            type = 'bar';                           // Bar chart
                            label = 'Tickets Sold';
                            break;

                        case 'RevenueReport':
                            labels = data.map(d => d.movie);        // Movie titles
                            dataset = data.map(d => d.revenue);     // Revenue per movie
                            type = 'pie';                           // Pie chart
                            label = 'Revenue (RM)';
                            break;

                        case 'TicketsOverTimeReport':
                            labels = data.map(d => d.date);         // Dates
                            dataset = data.map(d => d.ticketsSold); // Tickets sold on that date
                            type = 'line';                          // Line chart
                            label = 'Tickets Sold';
                            break;

                        case 'RevenueOverTimeReport':
                            labels = data.map(d => d.date);         // Dates
                            dataset = data.map(d => d.revenue);     // Revenue on that date
                            type = 'line';                          // Line chart
                            label = 'Revenue (RM)';
                            break;

                        case 'SeatTypeUsageReport':
                            labels = data.map(d => d.seatType);     // Seat types (Regular, VIP, etc.)
                            dataset = data.map(d => d.count);       // Count of each seat type
                            type = 'pie';                           // Pie chart
                            label = 'Seat Usage';
                            break;

                        case 'ShowtimePerformanceReport':
                            labels = data.map(d => d.showtime);     // Showtime identifiers
                            dataset = data.map(d => d.ticketsSold); // Tickets sold per showtime
                            type = 'bar';                           // Bar chart
                            label = 'Tickets Sold';
                            break;
                    }

                    // Destroy the previous chart instance if it exists
                    if(chart) chart.destroy();

                    // Create new chart using Chart.js
                    chart = new Chart(document.getElementById('chart').getContext('2d'), {
                        type: type,           // Chart type determined above
                        data: {
                            labels: labels,   // X-axis labels
                            datasets: [{
                                label: label, // Dataset label
                                data: dataset  // Y-axis values
                            }]
                        },
                        options: { responsive: true } // Make chart responsive
                    });
                },
                error: function(xhr, status, error) { // Called if AJAX fails
                    console.error('AJAX Error:', error); // Log error to console
                }
            });
        }

        // Initialize page
        $(document).ready(function() {
            loadReport('TicketsSoldReport'); // Load initial chart

            // Change chart when user selects a different report
            $('#reportSelector').change(function() {
                loadReport($(this).val()); // Switch chart dynamically
            });
        });
    </script>
}
