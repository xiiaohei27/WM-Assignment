@model List<Movie>
@{
	ViewBag.Title = "Manage Movie";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Movie</h2>
        <div>
            <a asp-action="CreateMovie" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Movie
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Genre</label>
                    <select name="genre" class="form-select" onchange="this.form.submit()">
                        <option value="">All Genre</option>
                        @foreach (var gen in ViewBag.Genre) //stucked
                        {
                            <option value="@gen"> 
                                @gen 
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Search</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Search by name..." value="@ViewBag.Search">
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        @if (!string.IsNullOrEmpty(ViewBag.Search) || !string.IsNullOrEmpty(ViewBag.CategoryId))
                        {
                            <a asp-action="FoodItems" class="btn btn-outline-secondary">Clear</a>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Genre</th>
                            <th>ReleaseDate</th>
                            <th>Classification</th>
                            <th>SpokenLanguage</th>
                            <th>RunningTime</th>
                            <th>Director</th>
                            <th>Cast</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center">No Movie found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var movie in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(movie.Image))
                                        {
                                            <img src="~/images/@movie.Image" alt="@movie.Title"
                                                 class="rounded" style="width: 50px; height: 50px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                                 style="width: 50px; height: 50px;">
                                                <span class="text-white">N/A</span>
                                            </div>
                                        }
                                    </td>
                                    <td>
                                        <strong>@movie.Title</strong>
                                        @if (!string.IsNullOrEmpty(movie.Description))
                                        {
                                            <br>

                                            <small class="text-muted">@(movie.Description.Length > 50 ? movie.Description.Substring(0, 50) + "..." : movie.Description)</small>
                                        }
                                    </td>
                                    <td><span class="badge bg-info">@movie.Genre</span></td>
                                    <td><strong>@movie.ReleaseDate.ToString("dd/MM/yyyy hh:mm:ss tt")</strong></td>
                                    <td>@movie.Classification</td>
                                    <td>@movie.SpokenLanguage</td>
                                    <td>@movie.RunningTime</td>
                                    <td>@movie.Director</td>
                                    <td>@movie.Cast</td>
                                    <td>
                                        <a asp-action="EditMovie" asp-route-id="@movie.Id"
                                           class="btn btn-sm btn-primary">Edit</a>
                                        <a asp-action="DeleteMovie" asp-route-id="@movie.Id"
                                           class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <p class="mt-3 text-muted">Total: @Model.Count item(s)</p>
</div>
