@model ShowtimeVM
@{
    ViewBag.Title = "Add Showtime";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="ShowtimeManage" class="btn btn-secondary">Back to List</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-body">
                    <form asp-action="CreateShowtime" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="MovieId" class="form-label">Movie</label>
                            <select asp-for="MovieId" id="movieSelect" class="form-select">
                                <option value="">-- Select Movie --</option>
                                @foreach (var movie in ViewBag.Movies)
                                {
                                    <option value="@movie.Id" data-runtime="@movie.RunningTime">
                                        @movie.Title
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="MovieId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Cinema</label>
                            <select id="cinemaSelect" class="form-select">
                                <option value="">-- Select Cinema --</option>
                                @foreach (var cinema in ViewBag.Cinemas)
                                {
                                    <option value="@cinema.Id">
                                        @cinema.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="HallId" class="form-label"></label>
                            <select asp-for="HallId" id="hallSelect" class="form-select">
                                <option value="">-- Select Hall --</option>
                                @foreach (var hall in ViewBag.Halls)
                                {
                                    <option value="@hall.Id" data-cinema="@hall.CinemaId.ToString()">
                                        @hall.Id
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="HallId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="StartDateTime" class="form-label"></label>
                            <input asp-for="StartDateTime" type="datetime-local" id="startTime" class="form-control"
                                   value="@(Model.StartDateTime > DateTime.MinValue ? Model.StartDateTime.ToString("yyyy-MM-ddTHH:mm") : "")"
                                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")">
                            <span asp-validation-for="StartDateTime" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">End Date & Time</label>
                            <input type="datetime-local" id="endTimeDisplay" class="form-control" readonly placeholder="Calculated automatically">
                        </div>

                        <div class="mb-3">
                            <label asp-for="TicketPrice" class="form-label"></label>
                            <input asp-for="TicketPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Ticket Price">
                            <span asp-validation-for="TicketPrice" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-plus-circle"></i> Add Showtime
                            </button>
                            <a asp-action="ShowtimeManage" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                    @if (TempData["Errors"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["Errors"]
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const cinemaSelect = document.getElementById('cinemaSelect'); //get Select dropdownlist
    const hallSelect = document.getElementById('hallSelect');

    cinemaSelect.addEventListener('change', () => { //run when change
        const selectedCinema = cinemaSelect.value;

        Array.from(hallSelect.options).forEach(option => { //loop through all options convert to array
            if (!option.value) //skip --Select Hall---
            {
            return;
            }
            if (option.dataset.cinema === selectedCinema) { //show hall of selected Cinema
                option.style.display = '';
            } else {
                option.style.display = 'none';
            }
        });

        // Reset hall selection
        const firstVisible = Array.from(hallSelect.options).find(o => o.style.display !== 'none' && o.value !== '');
        hallSelect.value = firstVisible ? firstVisible.value : ''; //reset if the user change cinema
    });
</script>

<script>
    const movieSelect = document.getElementById('movieSelect'); //get
    const startTimeInput = document.getElementById('startTime'); //get
    const endTimeDisplay = document.getElementById('endTimeDisplay'); //get

    function calculateEndTime() {
        const selectedOption = movieSelect.selectedOptions[0]; //selected movie
        const startVal = startTimeInput.value; //starttime value

        if (!selectedOption || !startVal) { //no movie selected
            endTimeDisplay.value = '';
            return;
        }

        const runtime = parseInt(selectedOption.dataset.runtime); // get the run time pass Int
        if (isNaN(runtime)) {
            endTimeDisplay.value = '';
            return;
        }

        // split into date and time then convert string into number for values
        const [datePart, timePart] = startVal.split('T');
        const [year, month, day] = datePart.split('-').map(Number);
        const [hours, minutes] = timePart.split(':').map(Number);
        const startDateTime = new Date(year, month - 1, day, hours, minutes);

        if (isNaN(startDateTime.getTime())) { //Validate start date
            endTimeDisplay.value = '';
            return;
        }

        // Calculate end time
        const endDateTime = new Date(startDateTime.getTime() + runtime * 60000);

        // Format
        const y = endDateTime.getFullYear();
        const m = String(endDateTime.getMonth() + 1).padStart(2, '0');
        const d = String(endDateTime.getDate()).padStart(2, '0');
        const h = String(endDateTime.getHours()).padStart(2, '0');
        const min = String(endDateTime.getMinutes()).padStart(2, '0');

        endTimeDisplay.value = `${y}-${m}-${d}T${h}:${min}`;
    }


    // Calculate when movie or start time changes
    movieSelect.addEventListener('change', calculateEndTime);
    startTimeInput.addEventListener('input', calculateEndTime);
</script>