@model List<FoodCategory>
@{
    ViewBag.Title = "Manage Food Categories";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="CreateCategory" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Add Category
            </a>
            <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Items Count</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center">No categories found.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td><strong>@category.Name</strong></td>
                                    <td>@category.Description</td>
                                    <td>
                                        <span class="badge bg-info">@category.FoodItems.Count items</span>
                                    </td>
                                    <td>
                                        <a asp-action="EditCategory" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-primary">Edit</a>
                                        <a asp-action="DeleteCategory" asp-route-id="@category.Id"
                                           class="btn btn-sm btn-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <p class="mt-3 text-muted">Total: @Model.Count category(ies)</p>
</div>