@model List<FoodOrder>
@{
    ViewBag.Title = "My Food Orders";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-receipt-cutoff"></i> My Food Orders</h2>
        <a asp-controller="Food" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-shop"></i> Order More Food
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
            <h4 class="mt-3">No Orders Yet</h4>
            <p>You haven't placed any food orders yet.</p>
            <a asp-controller="Food" asp-action="Index" class="btn btn-primary mt-2">
                <i class="bi bi-shop"></i> Browse Menu
            </a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                var isExpired = order.ExpiresAt < DateTime.Now;
                var timeRemaining = order.ExpiresAt - DateTime.Now;
                var statusColor = order.IsRedeemed ? "success" : isExpired ? "danger" : order.Status == "Confirmed" ? "info" : "warning";
                var borderColor = order.IsRedeemed ? "border-success" : isExpired ? "border-danger" : "";

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm @borderColor">
                        <div class="card-header bg-@statusColor text-white">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <strong><i class="bi bi-hash"></i> @order.RedemptionCode</strong>
                                    <br>
                                    <small><i class="bi bi-calendar3"></i> @order.OrderDateTime.ToString("MMM dd, yyyy hh:mm tt")</small>
                                </div>
                                <span class="badge bg-light text-@statusColor">
                                    @order.Status
                                </span>
                            </div>
                        </div>

                        <div class="card-body">
                            <h6 class="mb-3"><i class="bi bi-bag-check"></i> Items Ordered:</h6>
                            <ul class="list-unstyled mb-3">
                                @foreach (var item in order.OrderItems.Take(3))
                                {
                                    <li class="mb-2">
                                        <div class="d-flex justify-content-between">
                                            <span>
                                                <strong>@item.FoodItem.Name</strong>
                                                <small class="text-muted">× @item.Quantity</small>
                                            </span>
                                            <span class="text-end">RM @item.Subtotal.ToString("F2")</span>
                                        </div>
                                    </li>
                                }
                                @if (order.OrderItems.Count > 3)
                                {
                                    <li class="text-muted small">
                                        <i class="bi bi-three-dots"></i> +@(order.OrderItems.Count - 3) more item(s)
                                    </li>
                                }
                            </ul>

                            <hr>

                            <div class="d-flex justify-content-between mb-3">
                                <strong><i class="bi bi-cash-stack"></i> Total:</strong>
                                <strong class="text-primary">RM @order.TotalAmount.ToString("F2")</strong>
                            </div>

                            @if (order.IsRedeemed)
                            {
                                <div class="alert alert-success mb-0 py-2">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <small>Redeemed on @order.RedeemedAt?.ToString("MMM dd, hh:mm tt")</small>
                                </div>
                            }
                            else if (isExpired)
                            {
                                <div class="alert alert-danger mb-0 py-2">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                    <small>Expired</small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning mb-2 py-2">
                                    <i class="bi bi-clock"></i>
                                    <small>
                                        <strong>Expires in:</strong>
                                        @if (timeRemaining != null && timeRemaining.Value.TotalMinutes > 0)
                                        {
                                            if (timeRemaining.Value.TotalHours >= 1)
                                            {
                                                <span>@timeRemaining.Value.Hours h @timeRemaining.Value.Minutes m</span>
                                            }
                                            else
                                            {
                                                <span>@timeRemaining.Value.Minutes minutes</span>
                                            }
                                        }
                                    </small>
                                </div>
                                <a asp-action="OrderQR" asp-route-orderId="@order.Id" class="btn btn-primary w-100 btn-sm">
                                    <i class="bi bi-qr-code"></i> Show QR Code
                                </a>
                            }
                        </div>

                        <div class="card-footer bg-light">
                            <small class="text-muted">
                                <i class="bi bi-credit-card"></i> @order.PaymentMethod
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-4">
            <p class="text-muted">
                <i class="bi bi-info-circle"></i>
                Showing @Model.Count order(s) |
                Active: @Model.Count(o => !o.IsRedeemed && o.ExpiresAt > DateTime.Now) |
                Redeemed: @Model.Count(o => o.IsRedeemed) |
                Expired: @Model.Count(o => o.ExpiresAt < DateTime.Now && !o.IsRedeemed)
            </p>
        </div>
    }
</div>

<style>
    .card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.15) !important;
        }

    .border-success {
        border: 2px solid #198754 !important;
    }

    .border-danger {
        border: 2px solid #dc3545 !important;
    }
</style>