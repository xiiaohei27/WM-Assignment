@using Microsoft.EntityFrameworkCore
@inject DB DB

@{
    // Get 6 featured food items
    var featuredItems = DB.FoodItems
        .Include(f => f.Category)
        .Where(f => f.IsAvailable)
        .Take(6)
        .ToList();
}

<div class="row">
    @foreach (var item in featuredItems)
    {
        <div class="col-md-4 col-sm-6 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(item.Image))
                {
                    <img src="/images/food/@item.Image" class="card-img-top" alt="@item.Name"
                         style="height: 180px; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                         style="height: 180px;">
                        <span class="text-white">@item.Name</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    @if (!string.IsNullOrEmpty(item.Description))
                    {
                        <p class="card-text text-muted small">
                            @(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)
                        </p>
                    }
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="h5 mb-0 text-primary">RM @item.Price.ToString("F2")</span>
                        <span class="badge bg-info">@item.Category.Name</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>