@model FoodOrder
@{
    ViewBag.Title = "Order Confirmation";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <div class="mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-success" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
        </div>
        <h2>Order Placed Successfully!</h2>
        <p class="text-muted">Order ID: @Model.Id</p>
    </div>

    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Order Date:</strong></div>
                        <div class="col-sm-8">@Model.OrderDateTime.ToString("dddd, MMMM dd, yyyy hh:mm tt")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Payment Method:</strong></div>
                        <div class="col-sm-8">@Model.PaymentMethod</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Status:</strong></div>
                        <div class="col-sm-8">
                            <span class="badge bg-warning">@Model.Status</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5>Items Ordered</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <strong>@item.FoodItem.Name</strong>
                                <span class="text-muted">× @item.Quantity</span>
                            </div>
                            <strong>RM @item.Subtotal.ToString("F2")</strong>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between">
                        <h5>Total Amount:</h5>
                        <h5 class="text-primary">RM @Model.TotalAmount.ToString("F2")</h5>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a asp-action="Index" class="btn btn-primary me-2">Order More Food</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>