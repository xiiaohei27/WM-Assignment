@model FoodOrder
@{
    ViewBag.Title = "Order Confirmation";
    var isExpired = Model.ExpiresAt < DateTime.Now;
    var timeRemaining = Model.ExpiresAt - DateTime.Now;
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <div class="mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="text-success" viewBox="0 0 16 16">
                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
            </svg>
        </div>
        <h2>Order Placed Successfully!</h2>
        <p class="text-muted">Order ID: @Model.Id</p>
    </div>

    <div class="row">
        <div class="col-md-8 mx-auto">
            <!-- QR Code Card -->
            <div class="card mb-4 border-@(Model.IsRedeemed ? "success" : isExpired ? "danger" : "primary")">
                <div class="card-header bg-@(Model.IsRedeemed ? "success" : isExpired ? "danger" : "primary") text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-qr-code"></i> Redemption QR Code
                    </h5>
                </div>
                <div class="card-body text-center">
                    @if (Model.IsRedeemed)
                    {
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill"></i>
                            <strong>Already Redeemed</strong>
                            <p class="mb-0">This order was redeemed on @Model.RedeemedAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                    }
                    else if (isExpired)
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>Expired</strong>
                            <p class="mb-0">This order expired on @Model.ExpiresAt?.ToString("MMM dd, yyyy hh:mm tt")</p>
                        </div>
                    }
                    else
                    {
                        <img src="data:image/png;base64,@ViewBag.QRCodeBase64" alt="QR Code" class="img-fluid mb-3" style="max-width: 300px;">

                        <div class="alert alert-info">
                            <strong><i class="bi bi-info-circle"></i> Redemption Code:</strong>
                            <h3 class="mb-0 font-monospace">@Model.RedemptionCode</h3>
                        </div>

                        @if (timeRemaining != null && timeRemaining.Value.TotalMinutes > 0)
                        {
                            <div class="alert alert-warning">
                                <i class="bi bi-clock"></i>
                                <strong>Valid for:</strong>
                                @if (timeRemaining.Value.TotalHours >= 1)
                                {
                                    <span>@timeRemaining.Value.Hours hour(s) @timeRemaining.Value.Minutes minute(s)</span>
                                }
                                else
                                {
                                    <span>@timeRemaining.Value.Minutes minute(s)</span>
                                }
                            </div>
                        }

                        <p class="text-muted small mb-0">
                            <i class="bi bi-calendar"></i> Valid until: @Model.ExpiresAt?.ToString("MMM dd, yyyy hh:mm tt")
                        </p>
                    }
                </div>
            </div>

            <!-- Order Details Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Order Date:</strong></div>
                        <div class="col-sm-8">@Model.OrderDateTime.ToString("dddd, MMMM dd, yyyy hh:mm tt")</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Payment Method:</strong></div>
                        <div class="col-sm-8">@Model.PaymentMethod</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-4"><strong>Status:</strong></div>
                        <div class="col-sm-8">
                            <span class="badge bg-@(Model.IsRedeemed ? "success" : Model.Status == "Confirmed" ? "info" : "warning")">
                                @Model.Status
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Items Ordered Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Items Ordered</h5>
                </div>
                <div class="card-body">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <strong>@item.FoodItem.Name</strong>
                                <span class="text-muted">× @item.Quantity</span>
                            </div>
                            <strong>RM @item.Subtotal.ToString("F2")</strong>
                        </div>
                    }
                    <hr>
                    <div class="d-flex justify-content-between">
                        <h5>Total Amount:</h5>
                        <h5 class="text-primary">RM @Model.TotalAmount.ToString("F2")</h5>
                    </div>
                </div>
            </div>

            <!-- Instructions -->
            @if (!Model.IsRedeemed && !isExpired)
            {
                <div class="card mb-4 border-info">
                    <div class="card-body">
                        <h5><i class="bi bi-info-circle-fill text-info"></i> How to Redeem</h5>
                        <ol class="mb-0">
                            <li>Show this QR code or redemption code at the counter</li>
                            <li>Staff will scan the code or enter the redemption code</li>
                            <li>Collect your food and beverages</li>
                            <li>Order is valid for 2 hours from purchase time</li>
                        </ol>
                    </div>
                </div>
            }

            <div class="text-center">
                <a asp-action="Index" class="btn btn-primary me-2">Order More Food</a>
                <a asp-action="MyOrders" class="btn btn-outline-secondary me-2">View My Orders</a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back to Home</a>
            </div>
        </div>
    </div>
</div>

<style>
    .font-monospace {
        font-family: 'Courier New', monospace;
        letter-spacing: 0.2em;
    }
</style>