@model List<FoodItem>
@{
    ViewBag.Title = "Food & Beverage";
    var categories = ViewBag.Categories as List<FoodCategory>;
    var selectedCategoryId = ViewBag.SelectedCategoryId as string;
}

<div class="container mt-4">
    <h2>Food & Beverage Menu</h2>

    <!-- Category Filter -->
    <div class="mb-4">
        <a asp-action="Index" class="btn @(string.IsNullOrEmpty(selectedCategoryId) ? "btn-primary" : "btn-outline-primary")">
            All Items
        </a>
        @foreach (var category in categories)
        {
            <a asp-action="Index" asp-route-categoryId="@category.Id"
               class="btn @(selectedCategoryId == category.Id ? "btn-primary" : "btn-outline-primary")">
                @category.Name
            </a>
        }
    </div>

    <!-- Food Items Grid -->
    @if (!Model.Any())
    {
        <div class="alert alert-info">No food items available in this category.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(item.Image))
                        {
                            <img src="~/food/@item.Image" class="card-img-top" alt="@item.Name"
                                 style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
                                 style="height: 200px;">
                                <span class="text-white fs-4">@item.Name</span>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@item.Name</h5>
                            <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h4 mb-0 text-primary">RM @item.Price.ToString("F2")</span>
                                <span class="badge bg-info">@item.Category.Name</span>
                            </div>

                            <!-- Add to Cart Form -->
                            <form method="post" asp-action="AddToCart" class="d-flex gap-2">
                                <input type="hidden" name="foodItemId" value="@item.Id" />
                                <input type="number" name="quantity" value="1" min="1" max="10"
                                       class="form-control" style="width: 80px;">
                                <button type="submit" class="btn btn-success flex-grow-1">
                                    Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>