@model List<BookingHistoryVM>
@{
    ViewBag.Title = "My Booking History";
    var foodOrders = ViewBag.FoodOrders as List<FoodOrder>;
}

<div class="container mt-4">
    <ul class="nav nav-tabs mb-4" id="historyTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tickets-tab" data-bs-toggle="tab" data-bs-target="#tickets" type="button" role="tab">
                <i class="bi bi-ticket-perforated"></i> Movie Tickets
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="food-tab" data-bs-toggle="tab" data-bs-target="#food" type="button" role="tab">
                <i class="bi bi-cup-straw"></i> Food Orders
            </button>
        </li>
    </ul>

    <div class="tab-content" id="historyTabContent">
        <!-- Movie Tickets Tab -->
        <div class="tab-pane fade show active" id="tickets" role="tabpanel">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> You haven't booked any tickets yet.
                    <a asp-controller="Movie" asp-action="Index">Browse movies</a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var booking in Model.OrderByDescending(b => b.BookingDate))
                    {
                        var isPast = booking.Showtime < DateTime.Now;
                        <div class="col-md-6 mb-4">
                            <div class="card h-100 @(isPast ? "border-secondary" : "border-primary")">
                                <div class="card-header @(isPast ? "bg-secondary text-white" : "bg-primary text-white")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <strong>@booking.MovieTitle</strong>
                                        <span class="badge @(isPast ? "bg-light text-dark" : "bg-warning text-dark")">
                                            @(isPast ? "Past" : "Upcoming")
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <p class="mb-2">
                                        <i class="bi bi-geo-alt"></i> <strong>@booking.CinemaName</strong> - @booking.HallName
                                    </p>
                                    <p class="mb-2">
                                        <i class="bi bi-calendar-event"></i> @booking.Showtime.ToString("dddd, MMMM dd, yyyy")
                                    </p>
                                    <p class="mb-2">
                                        <i class="bi bi-clock"></i> @booking.Showtime.ToString("hh:mm tt")
                                    </p>
                                    <p class="mb-2">
                                        <i class="bi bi-receipt"></i> <strong>Seats:</strong> @string.Join(", ", booking.SeatNumbers)
                                    </p>

                                    @if (booking.FoodItems != null && booking.FoodItems.Any())
                                    {
                                        <hr>
                                        <p class="mb-2"><strong><i class="bi bi-cup-straw"></i> Food & Beverages:</strong></p>
                                        <ul class="list-unstyled ms-3">
                                            @foreach (var food in booking.FoodItems)
                                            {
                                                <li>@food.Name × @food.Quantity</li>
                                            }
                                        </ul>
                                    }

                                    <hr>
                                    <p class="text-muted small mb-0">
                                        <i class="bi bi-calendar-check"></i> Booked on: @booking.BookingDate.ToString("MMM dd, yyyy hh:mm tt")
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Food Orders Tab -->
        <div class="tab-pane fade" id="food" role="tabpanel">
            @if (foodOrders == null || !foodOrders.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle"></i> You haven't placed any food orders yet.
                    <a asp-controller="Food" asp-action="Index">Browse menu</a>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var order in foodOrders.OrderByDescending(o => o.OrderDateTime))
                    {
                        var isExpired = order.ExpiresAt < DateTime.Now;
                        var timeRemaining = order.ExpiresAt - DateTime.Now;

                        <div class="col-md-6 mb-4">
                            <div class="card h-100 @(order.IsRedeemed ? "border-success" : isExpired ? "border-danger" : "border-warning")">
                                <div class="card-header @(order.IsRedeemed ? "bg-success text-white" : isExpired ? "bg-danger text-white" : "bg-warning text-dark")">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong>Order #@order.RedemptionCode</strong>
                                            <br>
                                            <small>@order.OrderDateTime.ToString("MMM dd, yyyy hh:mm tt")</small>
                                        </div>
                                        <span class="badge @(order.IsRedeemed ? "bg-light text-success" : isExpired ? "bg-light text-danger" : "bg-primary")">
                                            @order.Status
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <h6>Items:</h6>
                                    <ul class="list-unstyled">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li class="mb-1">
                                                <strong>@item.FoodItem.Name</strong> × @item.Quantity
                                                <span class="float-end text-muted">RM @item.Subtotal.ToString("F2")</span>
                                            </li>
                                        }
                                    </ul>
                                    <hr>
                                    <div class="d-flex justify-content-between mb-3">
                                        <strong>Total:</strong>
                                        <strong class="text-primary">RM @order.TotalAmount.ToString("F2")</strong>
                                    </div>

                                    <div class="mb-2">
                                        <small class="text-muted">
                                            <i class="bi bi-credit-card"></i> Payment: @(order.PaymentMethod ?? "N/A")
                                        </small>
                                    </div>

                                    @if (order.IsRedeemed)
                                    {
                                        <div class="alert alert-success mb-0">
                                            <i class="bi bi-check-circle-fill"></i>
                                            <strong>Redeemed</strong><br>
                                            <small>@order.RedeemedAt?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                        </div>
                                    }
                                    else if (isExpired)
                                    {
                                        <div class="alert alert-danger mb-0">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            <strong>Expired</strong><br>
                                            <small>Expired on @order.ExpiresAt?.ToString("MMM dd, yyyy hh:mm tt")</small>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-2">
                                            <i class="bi bi-clock"></i>
                                            <strong>Valid for:</strong>
                                            @if (timeRemaining != null && timeRemaining.Value.TotalMinutes > 0)
                                            {
                                                if (timeRemaining.Value.TotalHours >= 1)
                                                {
                                                    <span>@timeRemaining.Value.Hours hour(s) @timeRemaining.Value.Minutes min(s)</span>
                                                }
                                                else
                                                {
                                                    <span>@timeRemaining.Value.Minutes minute(s)</span>
                                                }
                                            }
                                        </div>
                                        <a asp-controller="Food" asp-action="OrderQR" asp-route-orderId="@order.Id"
                                           class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-qr-code"></i> Show QR Code
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        color: #6c757d;
    }

        .nav-tabs .nav-link.active {
            color: #0d6efd;
            font-weight: 600;
        }
</style>