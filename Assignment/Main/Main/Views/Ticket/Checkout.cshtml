@inject DB db
@model TicketCheckoutVM
@{
    ViewBag.Title = "Checkout";
}

<h2>Checkout</h2>

<div>
    <h3>@Model.Showtime.Movie.Title</h3>
    <p>@Model.Showtime.Hall.Cinema.Name - @Model.Showtime.Hall.Name</p>
    <p>@Model.Showtime.StartDateTime.ToString("dddd, MMM dd yyyy hh:mm tt")</p>
</div>

<div>
    <h4>Selected Seats</h4>
    @if (Model.Seats.Any())
    {
        <ul>
            @foreach (var seat in Model.Seats)
            {
                <li>@seat.SeatNumber (@seat.SeatType)</li>
            }
        </ul>
    }
    else
    {
        <p>No seats selected.</p>
    }
</div>

<div>
    <h4>Food & Beverages</h4>
    @if (!Model.FoodCart.Any())
    {
        <p>No food items selected.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Qty</th>
                    <th>Unit Price</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.FoodCart)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Quantity</td>
                        <td>RM @item.Price.ToString("F2")</td>
                        <td>RM @((item.Price* item.Quantity).ToString("F2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div>
    <h4>Total Price</h4>
    @{
        decimal totalSeatPrice = Model.Seats.Sum(s => Model.Showtime.TicketPrice * s.Multiplier);
        decimal totalFoodPrice = Model.FoodCart.Sum(item => item.Price * item.Quantity);
        decimal totalPrice = totalSeatPrice + totalFoodPrice;
    }
    <p>RM @totalPrice.ToString("F2")</p>
</div>

<form method="post" asp-controller="Ticket" asp-action="ProcessCheckout">
    <button type="submit" class="btn btn-primary">Proceed to Payment</button>
</form>
