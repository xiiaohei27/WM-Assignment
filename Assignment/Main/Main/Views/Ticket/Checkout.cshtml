@inject DB db
@model TicketCheckoutVM
@inject IConfiguration configuration
@{
    ViewBag.Title = "6. Checkout";
    var siteKey = configuration["reCaptchaSettings:SiteKey"];
}

<div class="container my-4">

    <!-- Movie Info -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h3 class="card-title">@Model.Showtime.Movie.Title</h3>
            <p class="card-text"><strong>@Model.Showtime.Hall.Cinema.Name - @Model.Showtime.Hall.Name</strong></p>
            <p class="card-text"><strong>@Model.Showtime.StartDateTime.ToString("dddd, MMM dd yyyy hh:mm tt")</strong></p>
        </div>
    </div>

    <!-- Selected Seats -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h4>Selected Seats</h4>
            @if (Model.Seats.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Seat</th>
                                <th>Type</th>
                                <th>Ticket Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var seat in Model.Seats)
                            {
                                var seatPrice = Model.Showtime.TicketPrice * seat.Multiplier;
                                <tr>
                                    <td>@seat.SeatNumber</td>
                                    <td>@seat.SeatType</td>
                                    <td>RM @(Model.Showtime.TicketPrice.ToString("F2"))</td>
                                    <td>RM @(seatPrice.ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No seats selected.</p>
            }
        </div>
    </div>

    <!-- Food & Beverages -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h4>Food & Beverages</h4>
            @if (!Model.FoodCart.Any())
            {
                <p class="text-muted">No food items selected.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.FoodCart)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Quantity</td>
                                    <td>RM @(item.Price.ToString("F2"))</td>
                                    <td>RM @((item.Price* item.Quantity).ToString("F2"))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Total Price -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h4>Total Price</h4>
            @{
                decimal totalSeatPrice = Model.Seats.Sum(s => Model.Showtime.TicketPrice * s.Multiplier);
                decimal totalFoodPrice = Model.FoodCart.Sum(item => item.Price * item.Quantity);
                decimal totalPrice = totalSeatPrice + totalFoodPrice;
            }
            <h4 class="text-primary">RM @totalPrice.ToString("F2")</h4>
        </div>
    </div>

    <form method="post" asp-controller="Ticket" asp-action="ProcessCheckout" id="checkoutForm">

        <input type="hidden" id="recaptchaToken" asp-for="RecaptchaToken" />

        @* reCaptcha Checkbox *@
        <div class="card mb-4 shadow-sm">
            <div class="offset-sm-4 col-sm-8">
                <div class="recaptcha-box">
                    <div id="html_element"></div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-controller="Food" asp-action="Select" class="btn btn-outline-secondary">← Back</a>
            <button type="submit" class="btn btn-primary">Proceed to Payment</button>
        </div>
    </form>

</div>

<script>
    var onloadCallback = function () {
        grecaptcha.render('html_element', {
            sitekey: '@siteKey',
            callback: function (token) {
                document.getElementById("recaptchaToken").value = token;
            }
        });
    };
</script>

<script src="https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit"
        async defer>
</script>