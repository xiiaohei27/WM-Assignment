@model Movie

@{
    ViewBag.Title = "Movie | Detail";
}

<!-- Movie Poster -->
<img src="/images/@Model.Image" alt="@Model.Title"
     style="width:250px; height:auto;" />

<h2>@Model.Title</h2>

<!-- Basic info -->
<p><strong>Genre:</strong> @Model.Genre</p>
<p><strong>Classification:</strong> @Model.Classification</p>
<p><strong>Language:</strong> @Model.SpokenLanguage</p>
<p><strong>Running Time:</strong> @Model.RunningTime minutes</p>
<p><strong>Release Date:</strong> @Model.ReleaseDate.ToString("dd MMM yyyy")</p>

<!-- People -->
<p><strong>Director:</strong> @Model.Director</p>
<p><strong>Cast:</strong> @Model.Cast</p>

<!-- Description -->
<h4>Description</h4>
<p>@Model.Description</p>

<!-- Trailer -->
@if (!string.IsNullOrEmpty(Model.Trailer))
{
    <div>
        <h4>Trailer</h4>
        <video width="720" height="405" controls>
            <source src="/trailers/@Model.Trailer" type="video/mp4" />
            Your browser does not support the video tag.
        </video>
    </div>
}

<div class="d-flex justify-content-between mt-4">
    <a asp-controller="Seat" asp-action="SelectSeat" class="btn btn-outline-secondary">← Back</a>
    <a asp-controller="Cinema" asp-action="SelectCinema" asp-route-movieId="@Model.Id" class="btn btn-primary">Next →</a>
</div>

